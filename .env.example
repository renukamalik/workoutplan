# Postgres connection string (Neon). Leave empty to use a local file database for development.
DATABASE_URL=
# Long random string used to sign login cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The coach account created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public address of the app, used in messages to clients. Example: https://rerise.onrender.com
APP_URL=http://localhost:3000
# Optional: send emails from the app with Resend. Without it, the app opens your own email app instead.
RESEND_API_KEY=
EMAIL_FROM=Rerise <plans@yourdomain.com>
