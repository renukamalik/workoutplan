# Postgres connection string (Neon). Leave empty to use a local file database for development.
DATABASE_URL=
# Long random string used to sign login cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The coach account created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public address of the app, used in messages to clients. Example: https://rerise-app.onrender.com
APP_URL=https://rerise-app.onrender.com
# Optional: send emails from the app with Resend. Without it, the app opens your own email app instead.
RESEND_API_KEY=
EMAIL_FROM=Rerise <plans@yourdomain.com>

# AI for plans and the dashboard briefing. GitHub's free model service was retired on 30 July 2026.
# Free option: a Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Paid option: Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# gemini or anthropic. Leave empty to use whichever key is set.
AI_PROVIDER=
# Free AI services may learn from what you send. Health notes are only sent to a paid provider unless you set this to true.
AI_SHARE_HEALTH=
